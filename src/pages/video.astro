---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title="Video" active="video"><main class="wrap">
<h2>Exposición del equipo</h2><p class="small">Duración máxima: 7 minutos.</p>
{site.videoUrl?<iframe class="frame" src={site.videoUrl} title="Video de exposición" allowfullscreen></iframe>:<div class="empty frame">Pega la URL embed del video en site.ts → videoUrl</div>}
<h2 style="margin-top:3rem">Autoevaluación</h2>
<div class="grid">{site.equipo.map(m=><article class="card"><h3>{m.nombre}</h3><p><strong>Fortalezas:</strong> {m.fortalezas}</p><p><strong>Debilidades:</strong> {m.debilidades}</p></article>)}</div>
</main></Layout>
