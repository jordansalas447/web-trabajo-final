---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title="Inicio" active="inicio">
<header class="hero"><div class="wrap">
<p class="meta">{site.asignatura} · {site.ods}</p>
<h1>{site.titulo}</h1>
<svg class="mount" viewBox="0 0 800 260" role="img" aria-label="Montaña cuya nieve disminuye al mover el control">
 <defs><clipPath id="c"><rect id="cut" x="0" y="0" width="800" height="80"/></clipPath></defs>
 <path d="M0 260 L150 120 L240 170 L400 30 L560 150 L650 100 L800 260Z" fill="#1d5560"/>
 <path d="M0 260 L150 120 L240 170 L400 30 L560 150 L650 100 L800 260Z" fill="#f4fbfa" clip-path="url(#c)"/>
 <path d="M0 260 L120 190 L330 230 L520 195 L800 245 L800 260Z" fill="#0d2830"/>
</svg>
<div class="ctl"><label for="yr">Retroceso glaciar (ilustración)</label><input id="yr" type="range" min="0" max="100" value="0"><output id="o">Nevado completo</output></div>
</div></header>
<main class="wrap">
<h2>Objetivo del trabajo</h2><p>{site.objetivo}</p>
<h2 style="margin-top:3rem">Integrantes</h2>
<div class="grid">{site.equipo.map(m=><article class="card"><img class="avatar" src={m.foto} alt={'Foto de '+m.nombre} onerror="this.style.display='none'"/><h3>{m.nombre}</h3><p class="small">{m.carrera}<br/>Código: {m.codigo}</p></article>)}</div>
<h2 style="margin-top:3rem">Índice</h2>
<ol><li>Impactos en el Perú</li><li>Una propuesta por integrante</li><li>Video y autoevaluación</li><li>Planificación y evidencias</li><li>Referencias APA 7</li></ol>
</main>
<script>
const r=document.getElementById('yr') as HTMLInputElement,c=document.getElementById('cut'),o=document.getElementById('o');
r.addEventListener('input',()=>{const v=+r.value;c?.setAttribute('height',String(80-v*0.6));if(o)o.textContent=v<5?'Nevado completo':v>90?'Casi sin nieve':'Retrocediendo';});
</script>
</Layout>
