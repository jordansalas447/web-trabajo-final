---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title="Propuestas" active="propuestas">
  <!-- Hero Banner -->
  <section class="page-hero">
    <img src="/img/propuestas-mejora.jpeg" alt="Propuestas para un futuro sostenible" class="hero-bg" />
    <!-- <div class="wrap">
      <span class="badge">💡 Acciones concretas</span>
      <h2 style="color:var(--ice); margin-top:0.5rem">Propuestas para un futuro sostenible</h2>
      <p class="hero-subtitle">Cada integrante plantea una acción concreta para avanzar hacia la meta del ODS 13.</p>
    </div> -->
  </section>

  <main class="wrap">
    <!-- Intro image + text -->
    <div class="section-image-row fade-up">
      <div>
        <span class="section-label">🌱 Nuestras ideas</span>
        <h2>Propuestas de mejora</h2>
        <p style="margin-top:1rem">Las siguientes propuestas buscan mitigar a algunos de los principales impactos del cambio climático identificados en el Perú. Se plantean acciones aplicables desde comunidades, instituciones educativas y espacios universitarios, con el propósito de fortalecer la adaptación, la prevención y la sostenibilidad en relación con el ODS 13: Acción por el clima.</p>
      </div>
      <img src="/img/propuestas-mejora.jpeg" alt="Infografía de propuestas de mejora ODS 13" class="deco-img floating" />
    </div>

    <div class="section-divider"></div>

    <!-- Propuestas Cards - ancho completo -->
    <div style="margin-top:1rem; display:flex; flex-direction:column; gap:2.5rem; width:100%">
      {site.equipo.map((m, idx) => (
        <article class="card big fade-up" style={`transition-delay: ${idx * 0.15}s; width:100%`}>
          <span class="badge" style="margin-bottom:1rem">Propuesta {idx + 1}</span>
          <h3>{m.propuestaTitulo}</h3>
          <p class="small" style="margin:0.5rem 0; color:var(--teal)">{m.nombre} · {m.carrera}</p>
          <p>{m.propuesta}</p>
          <img
            src={m.img}
            alt={m.propuestaTitulo}
            style="width:100%; border-radius:12px; margin-top:1rem; aspect-ratio:16/10; object-fit:cover; border:1px solid var(--line)"
            onerror="this.outerHTML='<div class=&quot;empty&quot; style=&quot;padding:1.5rem; margin-top:1rem&quot;>📷 Imagen: public' + this.getAttribute('src') + '</div>'"
          />
          {m.slides ? (
            <iframe class="frame" src={m.slides} title={'Slides: ' + m.propuestaTitulo} allowfullscreen style="margin-top:1rem; width:100%"></iframe>
          ) : ( <></>
            // <div class="empty" style="margin-top:1rem; padding:1.2rem">📊 Slides de esta propuesta: pega la URL en site.ts → slides</div>
          )}
        </article>
      ))}
    </div>

    <!-- Decorative bottom image -->
    <div style="margin-top:3rem; text-align:center" class="fade-up">
      <img src="/img/sostenibilidad.jpeg" alt="Sostenibilidad y reciclaje" style="width:100%; max-width:500px; border-radius:var(--radius-lg); box-shadow:var(--shadow); border:1px solid var(--line)" />
    </div>
  </main>
</Layout>
