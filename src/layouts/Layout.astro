---
import '../styles/global.css';
import { site } from '../data/site';
const { title, active } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [['inicio','/','Inicio'],['impactos','/impactos','Impactos en el Perú'],['propuestas','/propuestas','Propuestas'],['video','/video','Video y autoevaluación'],['plan','/planificacion','Planificación'],['refs','/referencias','Referencias']];
---
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} | {site.ods}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet"></head>
<body><nav class="nav" aria-label="Principal">{links.map(([k,h,t])=><a href={b+h} aria-current={active===k?'page':undefined}>{t}</a>)}</nav>
<slot /><footer>{site.asignatura} · {site.universidad}</footer></body></html>
